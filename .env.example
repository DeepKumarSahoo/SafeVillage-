# Copy this file to .env and change the values.
# Never commit .env. The passwords below are hackathon DEMO accounts only.

APP_NAME=SafeVillage
ENVIRONMENT=development
DEBUG=false
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

# Use a long random value in any shared or production deployment.
SECRET_KEY=change-me-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite is for local demos. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://safevillage:password@localhost:5432/safevillage
DATABASE_URL=sqlite:///./safevillage.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Demo accounts are created only when SEED_DEMO_DATA=true.
DEMO_ADMIN_EMAIL=admin@safevillage.demo
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_CITIZEN_EMAIL=citizen@safevillage.demo
DEMO_CITIZEN_PASSWORD=Citizen@123

# Optional OpenAI-compatible chat provider. Leave the key empty to use the labelled demo fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional maps provider. The key stays on the server and is never sent to the browser.
MAPS_PROVIDER=google
MAPS_API_KEY=

LOG_LEVEL=INFO
